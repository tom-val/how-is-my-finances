<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Lets the listener post Finansai's own "Payment detected" notification (Android 13+ asks at runtime). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!--
          Reads notifications only after the user grants notification access in system settings,
          and keeps only those from allowlisted bank apps while the "Bank notifications" source is on.
        -->
        <service
            android:name="expo.modules.banknotifications.BankNotificationListenerService"
            android:exported="true"
            android:label="@string/bank_notifications_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
